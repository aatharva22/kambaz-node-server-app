# Copy to .env and fill in real values. Never commit the real .env.

# MongoDB connection string. For local dev, mongod default:
DATABASE_CONNECTION_STRING=mongodb://127.0.0.1:27017/kambaz

# Long random string used to sign session cookies.
SESSION_SECRET=replace-me-with-a-long-random-string

# Origin of the frontend client (must match for CORS + credentialed cookies).
CLIENT_URL=http://localhost:3000

# development | production
NODE_ENV=development

# Port the Express server listens on.
PORT=4000
